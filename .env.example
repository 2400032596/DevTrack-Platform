# Local Docker Compose settings. Copy this file to .env and generate your own JWT_SECRET.
POSTGRES_DB=devtrack
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_MINUTES=15
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PORT=5173

# For running the API outside Docker, use:
# DB_URL=jdbc:postgresql://localhost:5432/devtrack
# DB_USERNAME=devtrack
# DB_PASSWORD=change-this-local-password
# PORT=8080
